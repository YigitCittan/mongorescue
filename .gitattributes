# Embedded files are checksummed or compared byte for byte (schema migrations,
# dashboard sources): keep LF line endings in every checkout, Windows included.
*.sql text eol=lf
*.go text eol=lf
# Golden test outputs are compared byte for byte.
*.golden text eol=lf
# The OpenAPI document is embedded as JSON and compared with its YAML source;
# a CRLF checkout would put \r into the parsed strings.
docs/openapi.yaml text eol=lf
internal/server/openapi.json text eol=lf
