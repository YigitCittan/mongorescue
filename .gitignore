# ==============================================================================
# MongoRescue — .gitignore
# Professional Open-Source Standard for Go & Embedded Web Application
# ==============================================================================

# Binaries and Output Artifacts
bin/
dist/
build/
# Desktop app (Wails): keep the logo and the customized installer script; the
# binaries (build/bin), wailsjs and the files Wails regenerates stay ignored.
!/cmd/mongorescue-desktop/build/
/cmd/mongorescue-desktop/build/*
!/cmd/mongorescue-desktop/build/appicon.png
!/cmd/mongorescue-desktop/build/windows/
/cmd/mongorescue-desktop/build/windows/*
!/cmd/mongorescue-desktop/build/windows/icon.ico
!/cmd/mongorescue-desktop/build/windows/installer/
/cmd/mongorescue-desktop/build/windows/installer/*
!/cmd/mongorescue-desktop/build/windows/installer/project.nsi
/mongorescue
/mongorescue.exe
/mrescue
/mrescue.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go Test & Profiling Artifacts
*.test
*.out
coverage.out
coverage.html
profile.out
profile.pprof
__debug_bin*

# Local Backups, Dumps & Storage Dirs (Disaster Recovery & Test data)
/backups/
/storage/
/data/
*.dump
*.archive
*.gz
*.tar.gz
*.agz
# Golden test artifacts (tiny fake archives, TEST ONLY keys) are committed.
!internal/restore/testdata/compat/**
!internal/mongotools/testdata/prelude/**

# Secrets, Configuration Overrides & Local Environments
.env
.env.*
config.local.json
*.local.json
credentials.json
secrets/

# IDE & Editor Specific Files
.claude/
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.iml

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Docker & Containerization Overrides
docker-compose.override.yml
*.sock

# Temporary & Scratch Files
tmp/
temp/
scratch/
log/
logs/
*.log

# Web & Node Artifacts (if local tooling is run)
node_modules/
.npm/
.yarn/
.parcel-cache/
.vite/

# Fault-injection and load test reports (scripts/test-chaos-docker.sh)
/chaos-report/
